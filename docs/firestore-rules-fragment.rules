rules_version = '2';
// Insert this block INSIDE the existing service cloud.firestore /databases/{database}/documents
// rules in Firebase Console. Do not overwrite unrelated apps' rules.
match /spaces/household_budget_management_forbaby/{document=**} {
  allow read, write: if request.auth != null
    && request.auth.token.firebase.sign_in_provider == "google.com"
    && exists(/databases/$(database)/documents/approvedBudgetUsers/$(request.auth.uid));
}
match /approvedBudgetUsers/{uid} {
  allow read, write: if false; // Admin SDK / Console provision only.
}
